#!/usr/bin/env python3
"""Tracewise host agent: ships logs, crashes, restarts and deploys from wherever apps run.

    tracewise login --url https://tracewise.example.com --key <ingest key>
    tracewise detect                 # what can be watched on this machine
    tracewise init                   # write tracewise.json from what was found
    tracewise run                    # watch everything in tracewise.json
    tracewise watch pm2 | systemd --unit nginx | docker | kubernetes | file PATH --service NAME
                    | syslog | http URL --service NAME | supervisor | macos
    tracewise exec --service worker -- python worker.py   # wrap any process
    tracewise deploy --service checkout [--sha SHA]        # record a deploy from CI

Only needs Python 3.8+ and the standard library. Stack traces spread over several lines are
joined back into one event. Identical lines within a flush are collapsed into one with a count.
"""

